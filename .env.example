# Copy to .env and adjust. JWT_SECRET and DEFAULT_ADMIN_PASSWORD are REQUIRED —
# the app refuses to start without them.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite is the simplest option for a fresh machine. The app will create
# firewall.db automatically on first run.
DATABASE_URL=sqlite+aiosqlite:///./firewall.db
# Production: DATABASE_URL=postgresql+asyncpg://user:URL-ENCODED-PASS@localhost:5432/firewall

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
# Initial admin password, created on first login. Change it after first login.
DEFAULT_ADMIN_PASSWORD=change-me-Str0ng!

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8000
# LOG_LEVEL=INFO
# Comma-separated allowed origins, or "*". Empty = localhost dev defaults.
# CORS_ORIGINS=

# Optional: limit upload size (bytes). Default is 50MB if unset.
# MAX_UPLOAD_BYTES=52428800
